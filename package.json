{
  "name": "playwright-assignment",
  "version": "1.0.0",
  "description": "Automated test scripts (Playwright + TypeScript) for SauceDemo and Coffee Cart, created for a QA automation assignment.",
  "scripts": {
    "test": "playwright test",
    "test:saucedemo": "playwright test tests/saucedemo.spec.ts",
    "test:coffeeshop": "playwright test tests/coffeeshop.spec.ts",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "typescript": "^5.5.0"
  }
}
